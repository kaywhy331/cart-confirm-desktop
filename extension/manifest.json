{
  "manifest_version": 3,
  "key": "",
  "name": "Quick add",
  "short_name": "Quick add",
  "version": "3.6.8",
  "description": "Runs a traffic-governed, first-party, price-and-total-capped buy list on Target, Walmart, and Amazon.",
  "permissions": [
    "activeTab",
    "alarms",
    "storage",
    "declarativeNetRequest",
    "webRequest"
  ],
  "host_permissions": [
    "https://target.com/*",
    "https://www.target.com/*",
    "https://*.target.com/*",
    "https://walmart.com/*",
    "https://www.walmart.com/*",
    "https://*.walmart.com/*",
    "https://amazon.com/*",
    "https://www.amazon.com/*",
    "https://*.amazon.com/*",
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://target.com/*",
        "https://www.target.com/*",
        "https://walmart.com/*",
        "https://www.walmart.com/*",
        "https://amazon.com/*",
        "https://www.amazon.com/*"
      ],
      "js": ["retailers.js", "quick-add.js", "catalog-search.js", "evidence.js", "safety.js", "schedule-gate.js", "queue-capture.js", "content.js"],
      "run_at": "document_end"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Quick add"
  }
}
